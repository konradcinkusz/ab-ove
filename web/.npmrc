# FRONTEND-BFF.md §7 — one package manager for the whole frontend tree. These settings are
# what make "all apps members of one workspace" behave like a workspace rather than like
# several installs that happen to share a directory.

# A workspace dependency resolves to the workspace copy, never to a published one that
# happens to match the range. This is what @ab-ovo/web-kit will need on the day §7's second
# app arrives and the kit is extracted; wiring it now costs nothing.
link-workspace-packages=true
prefer-workspace-packages=true

# REPO-BASELINE.md §1 — a toolchain claim nobody enforces is not a claim. The Dockerfile
# and CI pin Node 22; engine-strict makes a mismatched local Node an install-time failure
# instead of a build-time mystery.
engine-strict=true

# FRONTEND-BFF.md §7 — "No app carries its own lockfile. There is one lockfile, at the
# workspace root." pnpm gives this for free: an install started from web/app walks up to
# pnpm-workspace.yaml and writes the lockfile HERE. The rule is therefore kept by not
# adding a pnpm-workspace.yaml (or a second .npmrc) below this directory.
